# Modèle de variables d'environnement. Le site ne lit PAS de fichier .env tout seul :
# fournissez ces variables au service qui lance Django (systemd EnvironmentFile, shell, hébergeur).
# En production (DEBUG=False), SECRET_KEY (50 caractères aléatoires minimum) et ALLOWED_HOSTS (sans « * ») sont
# obligatoires : le site refuse de démarrer sinon. En développement, ils ont des valeurs par défaut.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=*
# HSTS (HTTPS imposé par le navigateur) : 1 jour au départ, puis 31536000 (1 an) une fois le HTTPS vérifié
HSTS_SECONDS=86400
# Production : adresses du site, avec le schéma, séparées par des virgules
# Adresse publique du site : fixe les URL canoniques, le sitemap et les données structurées (SEO)
SITE_URL=
# Adresse de l'administration : https://<domaine>/<ADMIN_URL>/ . Vide = « back-office » ; « admin » est refusé en production.
ADMIN_URL=
CSRF_TRUSTED_ORIGINS=

# Base de données : SQLite tant que USE_MYSQL=False
USE_MYSQL=False
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Laisser vide si MySQL est sur le même serveur ; REQUIRED si la base est distante
MYSQL_SSL_MODE=
MYSQL_CONN_MAX_AGE=60

EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Adresse qui reçoit les messages des formulaires
CONTACT_EMAIL=organisationuciv@gmail.com
# Dossier du cache de production (compteurs du limiteur de débit) ; par défaut src/cache_cdn
CACHE_DIR=
