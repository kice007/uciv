              "children": [
                {
                  "type": "text",
                  "id": "MyxIo",
                  "name": "ligne 1",
                  "fill": "$blanc",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Donner la parole aux RH,",
                  "lineHeight": 1.05,
                  "textAlign": "center",
                  "fontFamily": "$f-titre",
                  "fontSize": 46,
                  "fontWeight": "800",
                  "letterSpacing": -1.4
                },
