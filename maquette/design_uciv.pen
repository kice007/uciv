                      "type": "text",
                      "id": "OhCbM",
                      "name": "citation",
                      "fill": "$encre",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "« Chaque jeune a un potentiel à révéler et un rôle à jouer dans la transformation de son pays. »",
                      "lineHeight": 1.25,
                      "fontFamily": "$f-accent",
                      "fontSize": 22,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    }
                  ]
                }
              ]
            }
