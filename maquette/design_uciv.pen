                      "lineHeight": 1.02,
                      "fontFamily": "$f-titre",
                      "fontSize": 76,
                      "fontWeight": "800",
                      "letterSpacing": -2.111111111111111
                    },
                    {
                      "type": "text",
                      "id": "k7UEZy",
                      "name": "Kouamé.",
                      "fill": "$orange",
                      "content": "Kouamé.",
                      "lineHeight": 1.04,
                      "fontFamily": "$f-accent",
                      "fontSize": 84,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "vaCXr",
                  "name": "Président et fondateur d'Une",
                  "fill": "$encre",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Entrepreneur du numérique, spécialiste en communication visuelle et audiovisuelle, fondateur-président d'Une Côte d'Ivoire Volontaire.",
                  "lineHeight": 1.65,
                  "fontFamily": "$f-texte",
                  "fontSize": 20,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "x0kHQ",
                  "name": "[Courte biographie à transme",
                  "fill": "$texte",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Titulaire d'un diplôme en Art et Image Numérique, Marshall Kouamé met ses compétences créatives et son expérience en communication au service de projets à impact social. Convaincu que l'engagement citoyen est un puissant levier de développement, il s'investit dans la mobilisation, la formation et l'accompagnement des jeunes à travers des initiatives qui favorisent le volontariat, l'employabilité et le leadership.",
                  "lineHeight": 1.65,
                  "fontFamily": "$f-texte",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "H0UJe",
                  "name": "vision",
                  "fill": "$texte",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "À travers UCIV, il porte une vision : faire du volontariat une véritable école d'expérience, de compétences et de leadership pour la jeunesse ivoirienne. Son ambition est de contribuer à l'émergence d'une génération de jeunes responsables, compétents et engagés, capables de prendre des initiatives et de participer activement au développement de la Côte d'Ivoire.",
                  "lineHeight": 1.65,
                  "fontFamily": "$f-texte",
                  "fontSize": 17,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "Dw7kQ",
                  "name": "conviction",
                  "width": "fill_container",
                  "stroke": "$orange",
                  "strokeWidth": {
                    "left": 3
                  },
                  "padding": [
                    4,
                    0,
                    4,
                    24
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "ZQnI9",
                      "name": "citation",
                      "fill": "$encre",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "« Chaque jeune a un potentiel à révéler et un rôle à jouer dans la transformation de son pays. »",
                      "lineHeight": 1.25,
                      "fontFamily": "$f-accent",
                      "fontSize": 28,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    }
                  ]
                }
              ]
            }
